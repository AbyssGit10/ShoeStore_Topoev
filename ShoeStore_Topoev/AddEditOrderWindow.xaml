<Window x:Class="ShoeStore_Topoev.AddEditOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Topoev"
        mc:Ignorable="d"
        Title="Добавление/редактирование заказа" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7FFF00" Padding="10" Margin="10">
            <TextBlock Text="Управление заказом" FontSize="22"
                       HorizontalAlignment="Center" FontFamily="Times New Roman"/>
        </Border>

        <Grid Grid.Row="1" Margin="20,10,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID заказа:"
                       VerticalAlignment="Center" Margin="0,10"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxbID"
                     IsReadOnly="True" Background="LightGray" Margin="0,10"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Артикул заказа:"
                       VerticalAlignment="Center" Margin="0,10"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OrderNumber}"
                     Margin="0,10"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Статус заказа:"
                       VerticalAlignment="Center" Margin="0,10"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbStatus"
                      SelectedValuePath="StatusID"
                      DisplayMemberPath="StatusName"
                      SelectedValue="{Binding StatusID}"
                      Margin="0,10"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Адрес пункта выдачи:"
                       VerticalAlignment="Center" Margin="0,10"/>
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CmbPoint"
                      SelectedValuePath="PointID"
                      DisplayMemberPath="FullAddress"
                      SelectedValue="{Binding PointID}"
                      Margin="0,10"/>

            <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Дата заказа:" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding OrderDate}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Text="Дата доставки:" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding DeliveryDate}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Button Grid.Row="2" Content="Сохранить данные"
                Click="SaveBtn_Click"
                Padding="20,10" Margin="0,10,0,20"
                HorizontalAlignment="Center"/>
    </Grid>
</Window>
