<Window x:Class="ShoeStore_Topoev.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Topoev"
        mc:Ignorable="d"
        Title="ООО Обувь - Авторизация" Height="450" Width="800">
    <Grid>
        <Border Height="140"  Grid.Row="0" Background="#7FFF00" Padding="10" Margin="10,17,10,277">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="C:\Users\User\Desktop\4 курс_1 семестр_Работа 2\Icon.png" Height="100" Margin="10"/>
                <TextBlock Text="Авторизация" FontSize="28" VerticalAlignment="Center" Margin="10" FontFamily="Times New Roman"/>
            </StackPanel>
        </Border>
        
        <StackPanel HorizontalAlignment="Center" Height="170" Width="200" Margin="0,100,0,0">
            <Label Content="Логин" Width="60" Margin="-146,0,0,0" FontFamily="Times New Roman" FontSize="16"/>
            <TextBox x:Name="txbLogin" Height="20" Width="200"/>
            <Label Content="Пароль" Width="60" Margin="-146,0,0,0" FontFamily="Times New Roman" FontSize="16"/>
            <PasswordBox x:Name="psbPassword" Height="20" Width="200"/>
            <Button x:Name="btnLogin" Content="Войти" Height="20" Width="200" Margin="0,20,0,0" FontFamily="Times New Roman" FontSize="14" Click="btnLogin_Click"/>
            <Button x:Name="btnGuest" Content="Войти как гость" Height="20" Width="100" Margin="0,13,0,0" FontFamily="Times New Roman" FontSize="14" Click="btnGuest_Click"/>
        </StackPanel>
    </Grid>
</Window>
